<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                 https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="Clinica">

        <!-- Clases persistentes del dominio. -->
        <class>com.programacion2.clinica.dominio.Persona</class>
        <class>com.programacion2.clinica.dominio.Paciente</class>
        <class>com.programacion2.clinica.dominio.Medico</class>
        <class>com.programacion2.clinica.dominio.Turno</class>

        <exclude-unlisted-classes/>

        <properties>

            <property
                name="javax.jdo.option.ConnectionDriverName"
                value="com.mysql.cj.jdbc.Driver"/>

            <!-- La base y el usuario se crean con database/crear_base.sql -->
            <property
                name="javax.jdo.option.ConnectionURL"
                value="jdbc:mysql://localhost:3306/clinica?serverTimezone=America/Argentina/Buenos_Aires"/>

            <!-- Usuario genérico del proyecto (no es una contraseña personal). -->
            <property
                name="javax.jdo.option.ConnectionUserName"
                value="programacion2"/>

            <property
                name="javax.jdo.option.ConnectionPassword"
                value="Programacion2"/>

            <!-- DataNucleus crea las tablas y columnas que falten al iniciar. -->
            <property
                name="datanucleus.schema.autoCreateAll"
                value="true"/>

        </properties>

    </persistence-unit>

</persistence>
